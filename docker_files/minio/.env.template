# Copy this file to .env and provide local-only credentials.
# MINIO_ROOT_USER requires at least 3 characters; MINIO_ROOT_PASSWORD requires at least 8.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Keep a release tag here (rather than `latest`) for repeatable local setups.
MINIO_IMAGE_TAG=RELEASE.2025-04-22T22-12-26Z

# Optional credentials for the currently disabled Iceberg/Nessie services.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
